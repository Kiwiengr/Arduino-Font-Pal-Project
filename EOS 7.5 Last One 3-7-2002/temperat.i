;
;   Temp.i
;
;**************************************************
;*
;*      Temperature Lookup Table include file
;*
;**************************************************
;*
;* Temperature (degrees Celsius) = 25 - (1/k) ln ( N/(255-N) )
;*
;* where, N is the ADC signal, 0 to 255 for 0 volts to 5.00 volts,
;*   and  k = 0.04368, is thermistor dependent.
;* (Voltage is measured at junction of thermistor and
;* 15K ohm pull-up resistor R438, connected to +5VD).
;*
;* Thermistor:
;* 
;*           Panasonic type PNT120
;*           R(25) = 15000 ohms
;*           Tempco -4.7%/degree C @ 25 degrees C
;*           R(25)/R(50) = 2.98
;*
;***

Temp:   equ     1            ;to prevent further inclusion

the_temp: dc.b  152 ;Temp. not defined for N = 0, so set to N = 1 value.
          dc.b  152,136,126,120,115,110,107,104,101, 98  ;N = 1 to 10
          dc.b   96, 94, 92, 90, 88, 87, 85, 84, 83, 81  ;N = 11 to 20
          dc.b   80, 79, 78, 77, 76, 75, 74, 73, 72, 71  ;N = 21 to 30
          dc.b   70, 69, 69, 68, 67, 66, 66, 65, 64, 64  ;N = 31 to 40
          dc.b   63, 62, 62, 61, 60, 60, 59, 58, 58, 57  ;N = 41 to 50
          dc.b   57, 56, 56, 55, 55, 54, 54, 53, 52, 52  ;N = 51 to 60
          dc.b   51, 51, 51, 50, 50, 49, 49, 48, 48, 47  ;N = 61 to 70
          dc.b   47, 46, 46, 45, 45, 45, 44, 44, 43, 43  ;N = 71 to 80
          dc.b   43, 42, 42, 41, 41, 40, 40, 40, 39, 39  ;N = 81 to 90
          dc.b   38, 38, 38, 37, 37, 37, 36, 36, 35, 35  ;N = 91 to 100
          dc.b   35, 34, 34, 34, 33, 33, 32, 32, 32, 31  ;N = 101 to 110
          dc.b   31, 31, 30, 30, 30, 29, 29, 28, 28, 28  ;N = 111 to 120
          dc.b   27, 27, 27, 26, 26, 26, 25, 25, 24, 24  ;N = 121 to 130
          dc.b   24, 23, 23, 23, 22, 22, 22, 21, 21, 20  ;N = 131 to 140
          dc.b   20, 20, 19, 19, 19, 18, 18, 18, 17, 17  ;N = 141 to 150
          dc.b   16, 16, 16, 15, 15, 15, 14, 14, 13, 13  ;N = 151 to 160
          dc.b   13, 12, 12, 12, 11, 11, 10, 10, 10,  9  ;N = 161 to 170
          dc.b    9,  8,  8,  7,  7,  7,  6,  6,  5,  5  ;N = 171 to 180
          dc.b    5,  4,  4,  3,  3,  2,  2,  1,  1,  0  ;N = 181 to 190
          dc.b    0, -1, -1, -1, -2, -2, -3, -4, -4, -5  ;N = 191 to 200
          dc.b   -5, -6, -6, -7, -7, -8, -8, -9,-10,-10  ;N = 201 to 210
          dc.b  -11,-12,-12,-13,-14,-14,-15,-16,-16,-17  ;N = 211 to 220
          dc.b  -18,-19,-19,-20,-21,-22,-23,-24,-25,-26  ;N = 221 to 230
          dc.b  -27,-28,-29,-30,-31,-33,-34,-35,-37,-38  ;N = 231 to 340
          dc.b  -40,-42,-44,-46,-48,-51,-54,-57,-60,-65  ;N = 241 to 250
          dc.b  -65,-65,-65,-65,-65                      ;N = 251 to 255

